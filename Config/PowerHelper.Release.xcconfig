// Release configuration of the privileged power helper. Its bundle identifier is the launchd label and the
// Mach service name; the app's bundle identifier and the signing team are embedded into its Info.plist so
// it can hold its clients to the app signed by the same team.
// Signing.local.xcconfig is not included: its provisioning profile belongs to the app (WeatherKit).
// The helper is signed with the same Developer ID identity from the command line and needs no profile.
#include "Version.xcconfig"
#include "Identity.Release.xcconfig"

PRODUCT_NAME = $(NOMAD_POWER_HELPER_PRODUCT_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(NOMAD_POWER_HELPER_LABEL)
